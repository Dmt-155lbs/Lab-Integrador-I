
# --- Login de la UI de Kestra ---
# Usuario: debe tener formato de email.
# Password: 8+ caracteres, al menos una mayuscula y un numero.
#           Usa solo letras y numeros (evita : # " ').
KESTRA_ADMIN_USER=admin@kestra.io
KESTRA_ADMIN_PASSWORD=CambiaEsto123

# --- Snowflake (objetos creados por infra/snowflake/01_bootstrap.sql) ---
# Account identifier: SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=LAB_INT_SVC
SNOWFLAKE_ROLE=LAB_INT_ROLE
SNOWFLAKE_WAREHOUSE=LAB_INT_WH
SNOWFLAKE_DATABASE=LAB_INT_NYC_TAXI

# Llave privada keys/rsa_key.p8 codificada en base64, en UNA sola linea:
#   Windows : [Convert]::ToBase64String([IO.File]::ReadAllBytes((Resolve-Path "keys\rsa_key.p8")))
#   Mac/Linux: base64 < keys/rsa_key.p8 | tr -d '\n'
SNOWFLAKE_PRIVATE_KEY_B64=