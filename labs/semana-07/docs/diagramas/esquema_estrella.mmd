    FCT_TRIPS }o--|| DIM_DATE : "dropoff_date_key"
    FCT_TRIPS }o--|| DIM_TIME : "pickup_time_key"
    FCT_TRIPS }o--|| DIM_TIME : "dropoff_time_key"
    FCT_TRIPS }o--|| DIM_ZONE : "pickup_location_id"
    FCT_TRIPS }o--|| DIM_ZONE : "dropoff_location_id"
    FCT_TRIPS }o--|| DIM_VENDOR : "vendor_id"
    FCT_TRIPS }o--|| DIM_RATE_CODE : "rate_code_id"
    FCT_TRIPS }o--|| DIM_PAYMENT_TYPE : "payment_type_id"

    FCT_TRIPS {
        varchar trip_key PK "MD5 del viaje - grano: 1 viaje valido"
        number pickup_date_key FK "AAAAMMDD"
        number pickup_time_key FK "hora 0-23"
        number dropoff_date_key FK
        number dropoff_time_key FK
        number pickup_location_id FK
        number dropoff_location_id FK
        number vendor_id FK
        number rate_code_id FK
        number payment_type_id FK
        timestamp pickup_datetime "degenerado"
        timestamp dropoff_datetime "degenerado"
        boolean is_store_and_forward "degenerado"
        varchar request_source "degenerado"
        date source_period "degenerado - linaje"
        number passenger_count "metrica"
        number trip_distance_miles "metrica"
        number trip_duration_minutes "metrica"
        number fare_amount "metrica"
        number extra_amount "metrica"
        number mta_tax_amount "metrica"
        number tip_amount "metrica"
        number tolls_amount "metrica"
        number improvement_surcharge_amount "metrica"
        number congestion_surcharge_amount "metrica"
        number airport_fee_amount "metrica"
        number cbd_congestion_fee_amount "metrica"
        number total_amount "metrica"
    }

    DIM_DATE {
        number date_key PK "AAAAMMDD"
        date full_date
        number year
        number quarter
        number month
        varchar month_name
        varchar year_month
        number day_of_month
        number day_of_week
        varchar day_name
        number iso_week
        boolean is_weekend
    }

    DIM_TIME {
        number time_key PK "0-23"
        number hour_of_day
        varchar hour_label
        varchar day_part
        boolean is_rush_hour_window
    }

    DIM_ZONE {
        number location_id PK "LocationID TLC"
        varchar borough
        varchar zone_name
        varchar service_zone
        boolean is_airport
        boolean is_unknown_zone
    }

    DIM_VENDOR {
        number vendor_id PK
        varchar vendor_name
    }

    DIM_RATE_CODE {
        number rate_code_id PK
        varchar rate_code_description
        boolean is_airport_rate
    }

    DIM_PAYMENT_TYPE {
        number payment_type_id PK
        varchar payment_type_description
        boolean is_paid_trip
    }
